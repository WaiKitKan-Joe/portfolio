from scipy.stats import norm
import numpy as np
import pandas as pd
import yfinance as yf
import matplotlib.pyplot as plt


# ----------------------------------------
# Settings
# ----------------------------------------

np.random.seed(42)

ticker = "GOOG"
period = "4y"

notional = 1000.0
coupon_rate = 0.12
maturity = 1.0
observations_per_year = 4

simulations = 5000
weekly_simulations = 2000

steps = 252
dt = maturity / steps

# Heston assumptions
kappa = 2.0
vol_of_variance = 0.50
heston_correlation = -0.70

observation_times = np.array([
    0.25,
    0.50,
    0.75,
    1.00
])

observation_steps = (
    observation_times * steps
).astype(int)


# ----------------------------------------
# Economic and market indicators
# ----------------------------------------

ticker_map = {
    "GOOG": "GOOG",
    "VIX": "^VIX",
    "3M Treasury": "^IRX",
    "10Y Treasury": "^TNX",
    "30Y Treasury": "^TYX",
    "S&P 500": "^GSPC",
    "Nasdaq": "^IXIC",
    "US Dollar": "DX-Y.NYB",
    "Gold": "GC=F",
    "Oil": "CL=F",
    "Copper": "HG=F",
    "High-Yield Bonds": "HYG",
    "Investment-Grade Bonds": "LQD",
    "Long Treasury Bonds": "TLT",
    "Inflation-Protected Bonds": "TIP"
}


# ----------------------------------------
# Download data
# ----------------------------------------

raw_data = yf.download(
    list(ticker_map.values()),
    period=period,
    interval="1d",
    auto_adjust=True,
    progress=False
)

close = raw_data["Close"].rename(
    columns={
        yahoo_ticker: name
        for name, yahoo_ticker
        in ticker_map.items()
    }
)

close = close.ffill().dropna()

issue_spot = float(close["GOOG"].iloc[-1])

goog_returns = np.log(
    close["GOOG"]
    / close["GOOG"].shift(1)
).dropna()

historical_volatility = float(
    goog_returns.std(ddof=1)
    * np.sqrt(252)
)

close["GOOG Variance"] = (
    goog_returns
    .rolling(20)
    .var()
    * 252
)

weekly = (
    close
    .resample("W-FRI")
    .last()
    .dropna()
)

risk_free_rate = (
    float(weekly["3M Treasury"].iloc[-1])
    / 100
)


# ----------------------------------------
# Dividend yield
# ----------------------------------------

goog = yf.Ticker(ticker)
dividends = goog.dividends

annual_dividend = (
    float(dividends.tail(4).sum())
    if len(dividends) > 0
    else 0.0
)

dividend_yield = np.log1p(
    annual_dividend / issue_spot
)


# ----------------------------------------
# Contract levels
# ----------------------------------------

autocall_level = issue_spot
barrier_level = 0.70 * issue_spot


# ----------------------------------------
# Common random numbers
# ----------------------------------------

rng = np.random.default_rng(42)

z_stock_matrix = rng.standard_normal(
    (steps, simulations)
)

z_independent_matrix = rng.standard_normal(
    (steps, simulations)
)


# ----------------------------------------
# Heston autocall pricing function
# ----------------------------------------

def price_autocall(
    current_spot,
    volatility,
    interest_rate,
    reference_spot,
    simulation_count=simulations,
    return_details=False
):

    initial_variance = volatility**2
    long_run_variance = volatility**2

    stock = np.full(
        simulation_count,
        current_spot
    )

    variance = np.full(
        simulation_count,
        initial_variance
    )

    present_values = np.zeros(
        simulation_count
    )

    autocalled = np.zeros(
        simulation_count,
        dtype=bool
    )

    payment_times = np.full(
        simulation_count,
        maturity
    )

    model_autocall_level = reference_spot
    model_barrier_level = (
        0.70 * reference_spot
    )

    for step in range(1, steps + 1):

        z_stock = z_stock_matrix[
            step - 1,
            :simulation_count
        ]

        z_independent = z_independent_matrix[
            step - 1,
            :simulation_count
        ]

        z_variance = (
            heston_correlation * z_stock
            + np.sqrt(
                1 - heston_correlation**2
            ) * z_independent
        )

        previous_variance = np.maximum(
            variance,
            0
        )

        variance = np.maximum(
            variance
            + kappa
            * (
                long_run_variance
                - previous_variance
            )
            * dt
            + vol_of_variance
            * np.sqrt(
                previous_variance * dt
            )
            * z_variance,
            0
        )

        stock *= np.exp(
            (
                interest_rate
                - dividend_yield
                - 0.5 * previous_variance
            )
            * dt
            + np.sqrt(
                previous_variance * dt
            )
            * z_stock
        )

        if step in observation_steps:

            index = np.where(
                observation_steps == step
            )[0][0]

            payment_time = (
                observation_times[index]
            )

            newly_autocalled = (
                (~autocalled)
                & (
                    stock
                    >= model_autocall_level
                )
            )

            payoff = notional * (
                1
                + coupon_rate
                * payment_time
            )

            present_values[
                newly_autocalled
            ] = (
                payoff
                * np.exp(
                    -interest_rate
                    * payment_time
                )
            )

            payment_times[
                newly_autocalled
            ] = payment_time

            autocalled[
                newly_autocalled
            ] = True

    not_autocalled = ~autocalled
    final_prices = stock.copy()

    total_coupon = (
        notional
        * coupon_rate
        * maturity
    )

    maturity_payoffs = np.where(
        final_prices
        >= model_barrier_level,
        notional + total_coupon,
        notional
        * final_prices
        / reference_spot
        + total_coupon
    )

    present_values[
        not_autocalled
    ] = (
        maturity_payoffs[
            not_autocalled
        ]
        * np.exp(
            -interest_rate
            * maturity
        )
    )

    fair_value = present_values.mean()

    if not return_details:
        return fair_value

    scenario_probabilities = np.array([
        np.mean(
            autocalled
            & np.isclose(
                payment_times,
                0.25
            )
        ),
        np.mean(
            autocalled
            & np.isclose(
                payment_times,
                0.50
            )
        ),
        np.mean(
            autocalled
            & np.isclose(
                payment_times,
                0.75
            )
        ),
        np.mean(
            autocalled
            & np.isclose(
                payment_times,
                1.00
            )
        ),
        np.mean(
            not_autocalled
            & (
                final_prices
                >= model_barrier_level
            )
        ),
        np.mean(
            not_autocalled
            & (
                final_prices
                < model_barrier_level
            )
        )
    ])

    return (
        fair_value,
        scenario_probabilities,
        present_values
    )


# ----------------------------------------
# Current value and scenario probabilities
# ----------------------------------------

(
    current_fair_value,
