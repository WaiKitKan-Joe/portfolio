# ----------------------------------------
# Greek sensitivities
# ----------------------------------------

spot_grid = np.linspace(
    0.60 * issue_spot,
    1.30 * issue_spot,
    25
)

spot_bump = 0.01 * issue_spot
volatility_bump = 0.01
rate_bump = 0.0001

deltas = []
gammas = []
vegas = []
rhos = []

for spot in spot_grid:

    base_value = price_autocall(
        spot,
        historical_volatility,
        risk_free_rate,
        issue_spot
    )

    spot_up = price_autocall(
        spot + spot_bump,
        historical_volatility,
        risk_free_rate,
        issue_spot
    )

    spot_down = price_autocall(
        spot - spot_bump,
        historical_volatility,
        risk_free_rate,
        issue_spot
    )

    volatility_up = price_autocall(
        spot,
        historical_volatility
        + volatility_bump,
        risk_free_rate,
        issue_spot
    )

    volatility_down = price_autocall(
        spot,
        max(
            historical_volatility
            - volatility_bump,
            0.01
        ),
        risk_free_rate,
        issue_spot
    )

    rate_up = price_autocall(
        spot,
        historical_volatility,
        risk_free_rate
        + rate_bump,
        issue_spot
    )

    rate_down = price_autocall(
        spot,
        historical_volatility,
        risk_free_rate
        - rate_bump,
        issue_spot
    )

    delta = (
        spot_up - spot_down
    ) / (
        2 * spot_bump
    )

    gamma = (
        spot_up
        - 2 * base_value
        + spot_down
    ) / (
        spot_bump**2
    )

    # Per one volatility point
    vega = (
        volatility_up
        - volatility_down
    ) / 2

    # Per one basis point
    rho = (
        rate_up - rate_down
    ) / 2

    deltas.append(delta)
    gammas.append(gamma)
    vegas.append(vega)
    rhos.append(rho)


# ----------------------------------------
# Vega hedge using ATM straddle
# ----------------------------------------

product_vega = (
    price_autocall(
        issue_spot,
        historical_volatility
        + volatility_bump,
        risk_free_rate,
        issue_spot
    )
    - price_autocall(
        issue_spot,
        historical_volatility
        - volatility_bump,
        risk_free_rate,
        issue_spot
    )
) / 2

K = issue_spot
T = maturity

d1 = (
    np.log(issue_spot / K)
    + (
        risk_free_rate
        - dividend_yield
        + 0.5
        * historical_volatility**2
    )
    * T
) / (
    historical_volatility
    * np.sqrt(T)
)

d2 = (
    d1
    - historical_volatility
    * np.sqrt(T)
)

call_price = (
    issue_spot
    * np.exp(
        -dividend_yield * T
    )
    * norm.cdf(d1)
    - K
    * np.exp(
        -risk_free_rate * T
    )
    * norm.cdf(d2)
)

put_price = (
    K
    * np.exp(
        -risk_free_rate * T
    )
    * norm.cdf(-d2)
    - issue_spot
    * np.exp(
        -dividend_yield * T
    )
    * norm.cdf(-d1)
)

straddle_price = (
    call_price + put_price
)

# Call Vega + put Vega
straddle_vega = (
    2
    * issue_spot
    * np.exp(
        -dividend_yield * T
    )
    * norm.pdf(d1)
    * np.sqrt(T)
    / 100
)

hedge_units = max(
    -product_vega
    / straddle_vega,
    0
)

print(
    f"\nProduct Vega: "
    f"${product_vega:.2f} per vol point"
)

print(
    f"Straddle Vega: "
    f"${straddle_vega:.2f} per vol point"
)

print(
    f"Straddles purchased: "
    f"{hedge_units:.3f}"
)

print(
    f"Initial hedge cost: "
    f"${hedge_units * straddle_price:.2f}"
)


