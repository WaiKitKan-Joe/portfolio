import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

import statsmodels.api as sm
import requests
from itertools import combinations

particular_date = pd.Timestamp.today().strftime('%Y-%m-%d')
url = (f"https://api.nasdaq.com/api/quote/NFLX/historical?"
       f"assetclass=stocks&fromdate=2021-10-21&limit=9999"
       f"&todate={particular_date}&random=28")

headers = {
    'User-Agent': (
        'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36'
    ),
    'Accept': 'application/json, text/plain, */*',
    'Origin': 'https://www.nasdaq.com',
    'referer': 'https://www.nasdaq.com/'
}

response = requests.get(url, headers=headers)
data = response.json()

df = pd.DataFrame(
    data['data']['tradesTable']['rows']
)

df = df.rename(columns={'close/Last':'close'})

column_to_be_dropped = [
    'open',
    'high',
    'low',
    'volume'
]

df = df.drop(columns=column_to_be_dropped)

df['close'] = pd.to_numeric(
    df['close']
    .astype(str)
    .replace('[$]','',regex=True),
    errors='coerce'
)

df['date'] = pd.to_datetime(
    df['date'],
    format='%m/%d/%Y',
)

df = df.set_index('date')
df = df.sort_index()

# set a study period
start_date = '2024-10-21'
end_date = df.index[-1]

df = df.loc[start_date:end_date]

# calculate log return
df['Log close price'] = np.log(df['close'])
df['Log return'] = (df['Log close price'] -
                    df['Log close price'].shift(1))

df['Rolling volatility'] = (
    df['Log return'].rolling(window=20).std() * np.sqrt(252)
)
df['Rolling variance'] = df['Rolling volatility'] ** 2

# calculate the return
df['return'] = df['close'].pct_change()

# plot the stock price movement
df['close'].plot()

plt.title('Netflix stock price movement')
plt.xlabel('Date')
plt.ylabel('Price')
plt.tight_layout()
plt.show()

# plot log return movement
plt.plot(
    df.index,
    df['Log return']
)
plt.title(
    f"Netflix Daily Log Returns: "
    f"{df.index.min().date()} to "
    f"{df.index.max().date()}"
)

plt.xlabel('date')
plt.ylabel('Log return')
plt.tight_layout()
plt.show()

df['5D MA'] = df['close'].rolling(5).mean()
df['10D MA'] = df['close'].rolling(10).mean()
df['20D MA'] = df['close'].rolling(20).mean()
df['50D MA'] = df['close'].rolling(50).mean()

# plot the MA
df[[
    'close',
    '20D MA',
    '10D MA',
    '5D MA'
]].plot()

days_10_above_20 = (
    df['20D MA'] < df['10D MA']
).sum()

days_10_below_20 = (
    df['20D MA'] > df['10D MA']
).sum()

ma_count_df =pd.DataFrame({
    'days_10_above_20': [days_10_above_20],
    'days_10_below_20': [days_10_below_20]
})

ma_count_df.plot(
    kind='bar'
)
plt.title('10-Day MA versus 20-Day MA')
plt.xlabel('days')
plt.ylabel('Number of trading days')
plt.tight_layout()
plt.show()

# set the trading strategy
df['position'] = np.select(
    [df['20D MA'] < df['10D MA'],
     df['20D MA'] > df['10D MA']],
    [1,-1], default = 0
)

df['trade'] = df['position'].diff()

df['trade signal'] = np.select(
    [
        df['trade'] ==2,
        df['trade'] ==-2,
        df['trade'] ==1,
        df['trade']==-1
    ],
    [
        'switch to long',
        'switch to short',
        'Enter long',
        'Enter short'
    ], default='No trade'
)

# plot the signal
signal_count = df['trade signal'].value_counts()

