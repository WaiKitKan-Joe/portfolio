# stress test
def evaluate_strategy(
        slippage = 0,
        transaction_cost = 0,
        position = test_df['position'].shift(1),
        returns = test_df['return']
):

    turnover = position.diff().abs().fillna(0)

    trading_cost = (slippage + transaction_cost) * turnover

    net_period_return = position * returns - trading_cost

    strategy_growth = (1 + net_period_return).cumprod()

    strategy_terminal_return = strategy_growth.iloc[-1] - 1

    evaluation_result = {
        'strategy_terminal_return': strategy_terminal_return,
        'strategy_growth': strategy_growth,
        'net_period_return': net_period_return,
        'turnover': turnover
    }

    return evaluation_result

