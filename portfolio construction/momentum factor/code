# maximize the sharpe
def negative_sharpe(
        weights,
        expected_returns,
        covariance_matrix,
        annual_rf
):
    portfolio_return = expected_returns @ weights

    portfolio_volatility = np.sqrt(
        weights.T @ covariance_matrix @ weights
    )

    return -(
        portfolio_return - annual_rf
    ) / portfolio_volatility

