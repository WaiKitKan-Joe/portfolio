# ============================================================
# SENSITIVITY ANALYSIS
# ============================================================

sensitivity_df = pd.DataFrame({
    "WACC": wacc_simulated,
    "Perpetual Growth": perpetual_growth,
    "EBIT Margin": ebit_margin,
    "D&A % of Sales": da_percentage,
    "Capex % of Sales": capex_percentage,
    "NWC % of Sales": nwc_percentage,
    "Year 1 Sales Growth": sales_growth[:, 0],
    "Year 2 Sales Growth": sales_growth[:, 1],
    "Year 3 Sales Growth": sales_growth[:, 2],
    "Year 4 Sales Growth": sales_growth[:, 3],
    "Year 5 Sales Growth": sales_growth[:, 4],
    "Enterprise Value": enterprise_value.to_numpy()
})

ev_sensitivity = (
    sensitivity_df
    .corr(numeric_only=True)["Enterprise Value"]
    .drop("Enterprise Value")
    .sort_values()
)

print("\nEV sensitivity by input")
print("=" * 55)

print(ev_sensitivity)

# plot the sensitivity
bar_colors = [
    "indianred" if value < 0 else "steelblue"
    for value in ev_sensitivity
]


fig, ax = plt.subplots(figsize=(9, 6))

bars = ax.barh(
    ev_sensitivity.index,
    ev_sensitivity.values,
    color=bar_colors,
    edgecolor="black",
