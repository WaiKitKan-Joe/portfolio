import requests
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt


# ============================================================
# DOWNLOAD EOG DAILY HISTORICAL PRICE DATA
# ============================================================

nasdaq_url = (
    "https://api.nasdaq.com/api/quote/EOG/historical"
)

end_date = pd.Timestamp.today().normalize()

start_date = (
    end_date
    - pd.DateOffset(years=5)
)

nasdaq_params = {
    "assetclass": "stocks",
    "fromdate": start_date.strftime("%Y-%m-%d"),
    "todate": end_date.strftime("%Y-%m-%d"),
    "limit": 5000
}

nasdaq_headers = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/140.0.0.0 Safari/537.36"
    ),
    "Accept": "application/json, text/plain, */*",
    "Accept-Language": "en-US,en;q=0.9",
    "Origin": "https://www.nasdaq.com",
    "Referer": (
        "https://www.nasdaq.com/"
        "market-activity/stocks/eog/historical"
    )
}

nasdaq_response = requests.get(
    nasdaq_url,
    params=nasdaq_params,
    headers=nasdaq_headers,
    timeout=30
)

# Stop the program if the request was unsuccessful
nasdaq_response.raise_for_status()

# Convert JSON response into a Python dictionary
nasdaq_json = nasdaq_response.json()

# Check that historical data exist
if (
    nasdaq_json.get("data") is None
    or nasdaq_json["data"].get("tradesTable") is None
    or nasdaq_json["data"]["tradesTable"].get("rows") is None
):
    raise ValueError(
        "Nasdaq did not return historical price data."
    )

trade_table = (
    nasdaq_json["data"]["tradesTable"]
)

# Convert the price records into a DataFrame
eog_daily = pd.DataFrame(
    trade_table["rows"]
)


# ============================================================
# CLEAN DAILY PRICE DATA
# ============================================================

# Keep only the necessary columns
eog_daily = eog_daily[
    [
        "date",
        "close"
    ]
].copy()

# Convert dates into datetime format
eog_daily["date"] = pd.to_datetime(
    eog_daily["date"],
    errors="coerce"
)

# Remove dollar signs and commas from closing prices
eog_daily["close"] = (
    eog_daily["close"]
    .astype(str)
    .str.replace(
        r"[$,]",
        "",
        regex=True
    )
)

# Convert prices into numeric values
eog_daily["close"] = pd.to_numeric(
    eog_daily["close"],
    errors="coerce"
)

# Remove rows with invalid dates or prices
eog_daily = eog_daily.dropna(
    subset=[
        "date",
        "close"
    ]
)

# Remove duplicate dates, if any
eog_daily = eog_daily.drop_duplicates(
    subset=["date"],
    keep="last"
)

# Sort observations from earliest to latest
eog_daily = (
    eog_daily
    .sort_values("date")
    .reset_index(drop=True)
)

print("\nCleaned daily EOG data")
print("=" * 60)

print(eog_daily.head())

print(
    f"\nFirst price date: "
    f"{eog_daily['date'].min():%Y-%m-%d}"
)

print(
    f"Latest price date: "
    f"{eog_daily['date'].max():%Y-%m-%d}"
)

print(
    f"Number of daily observations: "
    f"{len(eog_daily):,}"
)


# ============================================================
# CALCULATE DAILY RETURNS
# ============================================================

eog_daily["Daily_return"] = (
    eog_daily["close"]
    .pct_change()
)


# ============================================================
# CALCULATE SIMPLE MOVING AVERAGES
# ============================================================

eog_daily["SMA_20"] = (
    eog_daily["close"]
    .rolling(
        window=20,
        min_periods=20
    )
    .mean()
)

eog_daily["SMA_50"] = (
    eog_daily["close"]
    .rolling(
        window=50,
        min_periods=50
    )
    .mean()
)

eog_daily["SMA_200"] = (
    eog_daily["close"]
    .rolling(
        window=200,
        min_periods=200
    )
    .mean()
)


# ============================================================
# CALCULATE EXPONENTIAL MOVING AVERAGES
# ============================================================

eog_daily["EMA_20"] = (
    eog_daily["close"]
    .ewm(
        span=20,
        adjust=False # use the recursive EMA formula
    )
    .mean()
)

eog_daily["EMA_50"] = (
    eog_daily["close"]
    .ewm(
        span=50,
        adjust=False
    )
    .mean()
)


# ============================================================
# CALCULATE PRICE DISTANCE FROM MOVING AVERAGES
# ============================================================

eog_daily["Price_vs_SMA_20"] = (
    eog_daily["close"]
    / eog_daily["SMA_20"]
    - 1
)

eog_daily["Price_vs_SMA_50"] = (
    eog_daily["close"]
    / eog_daily["SMA_50"]
    - 1
)

eog_daily["Price_vs_SMA_200"] = (
    eog_daily["close"]
    / eog_daily["SMA_200"]
    - 1
)


# ============================================================
# IDENTIFY 50-DAY AND 200-DAY MOVING-AVERAGE CROSSOVERS
# ============================================================

# 1 means the 50-day SMA is above the 200-day SMA
# 0 means the 50-day SMA is below or equal to the 200-day SMA
eog_daily["MA_position"] = np.where(
    eog_daily["SMA_50"]
    > eog_daily["SMA_200"],
    1,
    0
)

# Compare today's position with yesterday's position
eog_daily["MA_crossover"] = (
    eog_daily["MA_position"]
    .diff()
)

# Golden cross:
# 50-day SMA moves from below to above the 200-day SMA
eog_daily["Golden_cross"] = (
    eog_daily["MA_crossover"] == 1
)

# Death cross:
# 50-day SMA moves from above to below the 200-day SMA
eog_daily["Death_cross"] = (
    eog_daily["MA_crossover"] == -1
)


# ============================================================
# EXTRACT CROSSOVER DATES
# ============================================================

golden_crosses = eog_daily.loc[
    eog_daily["Golden_cross"],
