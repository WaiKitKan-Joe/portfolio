# define NSS function
def nss_yield(
        maturity,
        beta0,
        beta1,
        beta2,
        beta3,
        tau1,
        tau2
):
    loading1 = (
        1 - np.exp(-maturity / tau1)
    ) / (maturity / tau1)

    loading2 = (
        loading1 - np.exp(-maturity / tau1)
    )

    loading3 = (
        1 - np.exp(-maturity / tau2)
    ) / (maturity / tau2) - np.exp(-maturity / tau2)

    fitted_yield = (
        beta0
        + beta1 * loading1
        + beta2 * loading2
        + beta3 * loading3
    )

    return fitted_yield

