    ridge_model.fit(
        x_train,
        historical_data[target_column]
    )

    predicted_change = (
        weight
        * ridge_model.predict(current_x)[0]
    )

    if abs(predicted_change) * 100 < threshold_bps:
        predicted_change = 0.0

    actual_list.append(actual_yield)

    model_list.append(
        current_yield + predicted_change
    )

    benchmark_list.append(current_yield)

    date_list.append(forecast_date)


result_df = pd.DataFrame(
    {
        'Actual yield': actual_list,
        'Model forecast': model_list,
        'Benchmark forecast': benchmark_list
    },
    index=date_list
)

result_df['Model error'] = (
    result_df['Actual yield']
    - result_df['Model forecast']
)

result_df['Benchmark error'] = (
    result_df['Actual yield']
    - result_df['Benchmark forecast']
)

model_rmse = np.sqrt(
    np.mean(result_df['Model error'] ** 2)
)

benchmark_rmse = np.sqrt(
    np.mean(result_df['Benchmark error'] ** 2)
)

model_mae = np.mean(
    np.abs(result_df['Model error'])
)

benchmark_mae = np.mean(
    np.abs(result_df['Benchmark error'])
)

rmse_improvement = (
    benchmark_rmse - model_rmse
) / benchmark_rmse

mae_improvement = (
    benchmark_mae - model_mae
) / benchmark_mae

print('\nOut-of-sample backtest result:')
print(f'Model RMSE: {model_rmse:.3f}')
print(f'Benchmark RMSE: {benchmark_rmse:.3f}')
print(f'Model MAE: {model_mae:.3f}')
print(f'Benchmark MAE: {benchmark_mae:.3f}')
print(f'RMSE improvement: {rmse_improvement:.3%}')
print(f'MAE improvement: {mae_improvement:.3%}')

# plot the result
result_df[[
    'Model forecast',
    'Benchmark forecast',
    'Actual yield'
]].plot(
    figsize=(8, 5)
)

plt.title(
    'Model, Benchmark, and Actual Yield'
)

plt.ylabel('Yield (%)')
plt.xlabel('Date')
plt.tight_layout()
plt.show()
