penalty = 2

for predictor_name, factors in predictor_sets.items():

    for window in window_candidates:

        for alpha in alpha_candidates:

            period_results = {}

            # Generate forecasts separately by period
            for period_name, dates in validation_periods.items():

                actual_changes = []
                raw_forecasts = []

                validation_dates = model_df.loc[
                    dates[0]:dates[1]
                ].index

                for forecast_date in validation_dates:

                    current_row = model_df.loc[
                        [forecast_date]
                    ]

                    historical_data = model_df.loc[
                        model_df.index < forecast_date
                    ].dropna(
                        subset=factors + [target_column]
                    )

                    if window is not None:
                        historical_data = (
                            historical_data.tail(window)
                        )

                    scaler = StandardScaler()

                    x_train = scaler.fit_transform(
                        historical_data[factors]
                    )

                    current_x = scaler.transform(
                        current_row[factors]
                    )

                    ridge_model = Ridge(
                        alpha=alpha
                    )

                    ridge_model.fit(
                        x_train,
                        historical_data[target_column]
                    )

                    actual_changes.append(
                        current_row[
                            target_column
                        ].iloc[0]
                    )

                    raw_forecasts.append(
                        ridge_model.predict(
                            current_x
                        )[0]
                    )

                period_results[period_name] = {
                    'actual':
                        np.array(actual_changes),

                    'raw_forecast':
                        np.array(raw_forecasts)
                }

            # Test weights and thresholds
            for weight in weight_candidates:

                for threshold_bps in (threshold_candidates_bps):

                    period_scores = []

                    for period_name in validation_periods:

                        actual = period_results[
                            period_name
                        ]['actual']

                        raw_forecast = period_results[
                            period_name
                        ]['raw_forecast']

                        weighted_forecast = weight * raw_forecast


                        predicted = np.where(
                            np.abs(
                                weighted_forecast
                            ) * 100 >= threshold_bps,
                            weighted_forecast,
                            0.0
                        )

                        model_errors = (actual - predicted)

                        model_rmse = np.sqrt(
                            np.mean(model_errors ** 2)
                        )

                        model_mae = np.mean(
                            np.abs(model_errors)
                        )

                        benchmark_rmse = np.sqrt(
                            np.mean(actual ** 2)
                        )

                        benchmark_mae = np.mean(
                            np.abs(actual)
                        )

                        score = max(
                            model_rmse / benchmark_rmse,
                            model_mae / benchmark_mae
                        )

                        period_scores.append(score)

                    period_scores = np.array(period_scores)

                    average_score = np.mean(period_scores)
                    score_variability = period_scores.std()

                    stable_score = (
                            average_score
                            + penalty * score_variability
                    )

                    if (average_score < 1 and
                            stable_score < best_score):
                        best_score = stable_score

                        best_parameters = {
                            'predictor_name': predictor_name,
                            'factor_column': factors.copy(),
                            'window': window,
                            'alpha': alpha,
                            'weight': weight,
                            'threshold_bps': threshold_bps,
                            'score': score,
                            'model_rmse': model_rmse,
                            'benchmark_rmse': benchmark_rmse,
                            'model_mae': model_mae,
                            'benchmark_mae': benchmark_mae
                        }


